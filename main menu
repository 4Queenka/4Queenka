-- BESTIES CORE - Da Hood All-in-One Script
-- Поддержка инжекторов: Xeno (xeno.com), Solara, Synapse, Krnl, ScriptWare
-- Функции: 0 delay стрельба из пистолетов, Silent Aim, телепорт к предметам, настраиваемая GUI
-- Получено с GitHub репозиториев: matrixhub, v3rmillion, russian-exploits

-- Отключение всех стандартных задержек ввода
local function disableInputDelay()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local args = {...}
        if self.Name == "FireServer" and tostring(args[1]):find("Shoot") then
            return
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

-- Основная функция: 0 задержки для оружия (авто-клик с частотой обновления рендера)
local function zeroDelayWeapon(toolName)
    local player = game.Players.LocalPlayer
    local mouse = player:GetMouse()
    local function getTool()
        if player.Character then
            local tool = player.Character:FindFirstChildWhichIsA("Tool")
            if tool and (not toolName or tool.Name:find(toolName)) then
                return tool
            end
        end
        return nil
    end
    
    local tool = getTool()
    if not tool then
        warn("Tool not found, waiting...")
        return
    end
    
    local shootEvent = nil
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("shoot") or v.Name:lower():find("fire")) then
            shootEvent = v
            break
        end
    end
    if not shootEvent then
        shootEvent = game:GetService("ReplicatedStorage"):FindFirstChild("WeaponEvent", true)
    end
    
    game:GetService("RunService").RenderStepped:Connect(function()
        if getTool() == tool and tool.Parent == player.Character then
            shootEvent:FireServer(tool, { Position = mouse.Hit.Position, Normal = Vector3.new(0,0,0) })
            local fireFunction = tool:FindFirstChild("Fire")
            if fireFunction and type(fireFunction) == "function" then
                fireFunction(tool)
            end
        end
    end)
end

-- Silent Aim: расчёт углов, обход античит-проверок
local function silentAim(settings)
    local player = game.Players.LocalPlayer
    local mouse = player:GetMouse()
    local currentTarget = nil
    local fov = settings.FOV or 90
    local smooth = settings.Smooth or 0.2
    local checkVisible = settings.VisibilityCheck or false
    
    local function getClosestPlayer()
        local closest = nil
        local closestAngle = fov
        local camera = workspace.CurrentCamera
        local character = player.Character
        if not character then return nil end
        local rootPos = character:FindFirstChild("HumanoidRootPart").Position
        
        for _, other in pairs(game.Players:GetPlayers()) do
            if other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
                local targetRoot = other.Character.HumanoidRootPart
                local targetPos = targetRoot.Position
                local screenPoint, onScreen = camera:WorldToScreenPoint(targetPos)
                if onScreen then
                    local angle = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPoint.X, screenPoint.Y)).magnitude
                    if angle < closestAngle then
                        if checkVisible then
                            local ray = Ray.new(camera.CFrame.Position, (targetPos - camera.CFrame.Position).unit * 500)
                            local hit = workspace:FindPartOnRay(ray, character)
                            if hit and hit:IsDescendantOf(other.Character) then
                                closest = other
                                closestAngle = angle
                            end
                        else
                            closest = other
                            closestAngle = angle
                        end
                    end
                end
            end
        end
        return closest
    end
    
    -- Перехват локального mouse.Hit
    local mt = getrawmetatable(game)
    local oldIdx = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if self == mouse and key == "Hit" then
            if currentTarget and currentTarget.Character then
                local targetPart = currentTarget.Character:FindFirstChild("Head") or currentTarget.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    return CFrame.new(targetPart.Position)
                end
            end
        end
        return oldIdx(self, key)
    end)
    setreadonly(mt, true)
    
    game:GetService("RunService").RenderStepped:Connect(function()
        currentTarget = getClosestPlayer()
    end)
end

-- Телепорт к предметам (лоадер на основе RemoteEvent или CFrame)
local function teleportToItems(itemNameFilter)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local items = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find(itemNameFilter:lower()) then
            table.insert(items, v)
        elseif v:IsA("Model") and v:FindFirstChildWhichIsA("BasePart") then
            if v.Name:lower():find(itemNameFilter:lower()) then
                table.insert(items, v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart"))
            end
        end
    end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TeleportItemsGUI"
    screenGui.Parent = player.PlayerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 400)
    frame.Position = UDim2.new(0, 10, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
    frame.BackgroundTransparency = 0.2
    frame.Parent = screenGui
    
    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, -10, 1, -30)
    list.Position = UDim2.new(0, 5, 0, 25)
    list.BackgroundTransparency = 1
    list.Parent = frame
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 2)
    layout.Parent = list
    
    for idx, item in ipairs(items) do
        if item then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 30)
            btn.Text = item.Name .. " (" .. tostring(idx) .. ")"
            btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            btn.Parent = list
            btn.MouseButton1Click:Connect(function()
                if item and item.Parent then
                    hrp.CFrame = item.CFrame * CFrame.new(0, 2, 0)
                end
            end)
        end
    end
end

